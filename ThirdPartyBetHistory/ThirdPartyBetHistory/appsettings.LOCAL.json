{
  "EnvironmentName": "LOCAL",
  "ServiceType": "Worker",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "ExcludesMessage": [
    "/health",
    "{HostingRequestStartingLog:l}",
    "Executing endpoint '{EndpointName}'",
    "Route matched with {RouteData}.",
    "Executing ObjectResult, writing value of type '{Type}'",
    "Executed action {ActionName}",
    "Executed endpoint '{EndpointName}'",
    "{HostingRequestFinishedLog:l}",
    "Executing ContentResult with HTTP Response ContentType of {ContentType}",
    "Executing {ObjectResultType}, writing value of type '{Type}'.",
    "Executing JsonResult, writing value of type '{Type}'.",
    "Received HTTP response headers after {ElapsedMilliseconds}ms - {StatusCode}",
    "Executing action method {ActionName} - Validation state: {ValidationState}",
    "Executed action method {ActionName}, returned result {ActionResult} in {ElapsedMilliseconds}ms.",
    "Executing StatusCodeResult, setting HTTP status code {StatusCode}"
  ],
  "ExcludesResponseEmptyMessage": "RESPONSE: ",
  "ExcludesApiEndpoint": [
    "/health"
  ],
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "Sentry": {
    "Dsn": "https://932f6035127bf2ca4a97269a8f500a7d@sentry-s1.nexentgame.com/16",
    "SendDefaultPii": true,
    "MaxRequestBodySize": "Always",
    "MinimumBreadcrumbLevel": "Debug",
    "MinimumEventLevel": "Warning",
    "AttachStackTrace": true,
    "Debug": true,
    "DiagnosticLevel": "Error",
    "TracesSampleRate": 1.0,
    "Environment": "LOCAL"
  },
  "OpenSearch": {
    "Uri": "logstash.nexdev.net",
    "Port": 31853,
    "Env": "LOCAL"
  },
  "ConfigService": [ "http://ne-s1-config-service-local-service:5000/" ]
}