{
    "ServiceType": "Worker",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Serilog": {
        "Name": "ServiceFile",
        "MinimumLevel": {
            "Default": "Information",
            "Overwrite": {
                "Name": "Microsoft",
                "Level": "Error"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "/tpwager/tpwager-.log",
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 60,
                    "fileSizeLimitBytes": 10485760,
                    "rollOnFileSizeLimit": true
                }
            },
            {
                "Name": "Console",
                "Args": {
                    //"formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
                }
            }
        ]
    },
    "ExcludesMessage": [
        "/health",
        "{HostingRequestStartingLog:l}",
        "Executing endpoint '{EndpointName}'",
        "Route matched with {RouteData}.",
        "Executing ObjectResult, writing value of type '{Type}'",
        "Executed action {ActionName}",
        "Executed endpoint '{EndpointName}'",
        "{HostingRequestFinishedLog:l}",
        "Executing ContentResult with HTTP Response ContentType of {ContentType}",
        "Worker running at: {time}",
        "End processing HTTP request after {ElapsedMilliseconds}ms - {StatusCode}",
        "Received HTTP response after {ElapsedMilliseconds}ms - {StatusCode}",
        "Sending HTTP request {HttpMethod} {Uri}",
        "Start processing HTTP request {HttpMethod} {Uri}"
    ],
    "ExcludesApiEndpoint": [
        "/health"
    ],
    "AllowedHosts": "*",
    "Kestrel": {
        "EndPoints": {
            "Http": {
                "Url": "http://*:8888"
            }
        }
    },
    "TpSWserviceUrl": "http://tp.n88dev.com:59259"
}
