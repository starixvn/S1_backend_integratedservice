{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Serilog": {
        "Name": "ServiceFile",
        "MinimumLevel": {
            "Default": "Information",
            "Overwrite": {
                "Name": "Microsoft",
                "Level": "Error"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "c:/logs/tpwager/tpwager-.log",
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 60,
                    "fileSizeLimitBytes": 10485760,
                    "rollOnFileSizeLimit": true,
                    "restrictedToMinimumLevel": "Warning"
                }
            },
            {
                "Name": "Console",
                "Args": {
                    //"formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
                }
            }
        ]
    },
