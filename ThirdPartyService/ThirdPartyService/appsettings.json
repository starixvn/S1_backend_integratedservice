{
  "ServiceType": "API",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/tpservice/tpservice-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "ExcludesMessage": [
    "/health",
    "{HostingRequestStartingLog:l}",
    "Executing endpoint '{EndpointName}'",
    "Route matched with {RouteData}.",
    "Executing ObjectResult, writing value of type '{Type}'",
    "Executed action {ActionName}",
    "Executed endpoint '{EndpointName}'",
    "{HostingRequestFinishedLog:l}",
    "Executing ContentResult with HTTP Response ContentType of {ContentType}",
    "Worker running at: {time}",
    "Executing {ObjectResultType}, writing value of type '{Type}'.",
  ],
  "ExcludesApiEndpoint": [
    "/health"
  ],
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:55996"
      }
    }
  },
  "GetTpBalanceParam": {
    "RunGetBalanceWorker": true, //Not Null.true = run, false = not run.
    "TpId": [
      1,    //saba
      27,   //PT
      31,   //9W
      22   //Mega
    ], //Not Null
    "Period": 2, //Not Null.1=by Hour,2=by Day
    "IntervalHour": 1, //Default 0.When Period=1.This Parameter have to > 0.
    "SpecifiedHour": 0, //Default 0.When Period=2.This Parameter not allow null and range is 0~23 in utc+8.
    "ReRunTime": 3, //Not Null.In Period Time Can try N Times.
    "CheckTime": 10, //Not Null.Every 10 secs check whether this work has already run
    "ColdDownTime": 10 //Not Null.Every thread sleep 10 secs when finish
  }
}
