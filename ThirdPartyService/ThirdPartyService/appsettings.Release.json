{
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "e:/logs/release/tpservice/tpservice-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "ConnectionString": "server=10.4.194.33;port=3306;user=nova88;database=Siebog;password=Aa12345678!;",
    "ConnectionStringReport": "server=10.4.194.34;port=3306;user=nova88;database=Siebog;password=Aa12345678!;"
  },
  "ProxyHost": "10.4.194.104",
  "ProxyPort": 3128,
  "Environment": "Release",
  "GetTpBalanceParam": {
    "RunGetBalanceWorker": true, //Not Null.true = run, false = not run.
    "TpId": [ 1, 27, 31 ], //Not Null.1=Saba,27=PT,31=9W
    "Period": 1, //Not Null.1=by Hour,2=by Day
    "IntervalHour": 1, //Default 0.When Period=1.This Parameter have to > 0.
    "SpecifiedHour": 8, //Default 0.When Period=2.This Parameter not allow null and range is 0~23 in utc+8.
    "CheckTime": 10, //Not Null.Every 10 secs check whether this work has already run
    "ColdDownTime": 10 //Not Null.Every thread sleep 10 secs when finish
  }
}
