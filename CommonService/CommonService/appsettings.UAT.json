{
    "env": "UAT",
    "ServiceType": "API",
    "AllowedHosts": "*",
    "Kestrel": {
        "EndPoints": {
            "Http": {
                "Url": "http://*:5000"
            }
        }
    },
    "Serilog": {
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "c:/logs/common/common-.log"
                }
            }
        ]
    },
    "TokenExpireTime": 60,
    "ConfigService": [ "http://ne-s1-config-service-uat-service:5000/" ],
    "Sentry": {
        "Dsn": "http://2f037423147eed67f3995e806230fb6b@vn-s1-sentry-uat.nebula.prod/13",
        "SendDefaultPii": true,
        "MaxRequestBodySize": "Always",
        "MinimumBreadcrumbLevel": "Debug",
        "MinimumEventLevel": "Warning",
        "AttachStackTrace": true,
        "Debug": true,
        "DiagnosticLevel": "Error",
        "TracesSampleRate": 1.0
    }
}
