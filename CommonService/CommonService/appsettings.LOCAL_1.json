{
  "env": "LOCAL",
  "ServiceType": "API",
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "c:/logs/common/common-.log"
        }
      }
    ]
  },
  "TokenExpireTime": 60,
  "ConfigService": ["http://ne-s1-config-service-local1-service:5000/"],
  "Sentry": {
    "Dsn": "https://48a9ac90790cc8267250b8f2fd4ad824@sentry-s1.nexentgame.com/14",
    "SendDefaultPii": true,
    "MaxRequestBodySize": "Always",
    "MinimumBreadcrumbLevel": "Debug",
    "MinimumEventLevel": "Warning",
    "AttachStackTrace": true,
    "Debug": true,
    "DiagnosticLevel": "Error",
    "TracesSampleRate": 1.0
  }
}
