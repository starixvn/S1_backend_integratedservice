{
  "env": "Local",
  "ServiceType": "API",
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "c:/logs/common/common-.log"
        }
      }
    ]
  },
  "ConfigService": [ "https://s1-config-service.nexdev.net/Local/" ]
}
