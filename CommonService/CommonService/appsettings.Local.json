{
  "env": "LOCAL",
  "ServiceType": "API",
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "c:/logs/common/common-.log"
        }
      }
    ]
  },
  "TokenExpireTime": 60,
  "ConfigService": [ "http://ne-s1-config-service-local-service:5000/" ],
