{
    "env": "Development",
    "ServiceType": "API",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Serilog": {
        "Name": "ServiceFile",
        "MinimumLevel": {
            "Default": "Information",
            "Overwrite": {
                "Name": "Microsoft",
                "Level": "Error"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "/common/common-.log",
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 60,
                    "fileSizeLimitBytes": 10485760,
                    "rollOnFileSizeLimit": true
                }
            },
            {
                "Name": "Console"
            }
        ]
    },
    "ExcludesMessage": [
        "/health",
        "{HostingRequestStartingLog:l}",
        "Executing endpoint '{EndpointName}'",
        "Route matched with {RouteData}.",
        "Executing ObjectResult, writing value of type '{Type}'",
        "Executed action {ActionName}",
        "Executed endpoint '{EndpointName}'",
        "{HostingRequestFinishedLog:l}",
        "Executing ContentResult with HTTP Response ContentType of {ContentType}",
        "Executing {ObjectResultType}, writing value of type '{Type}'.",
        "Executing JsonResult, writing value of type '{Type}'.",
        "Received HTTP response headers after {ElapsedMilliseconds}ms - {StatusCode}",
        "Executing action method {ActionName} - Validation state: {ValidationState}",
        "Executed action method {ActionName}, returned result {ActionResult} in {ElapsedMilliseconds}ms.",
        "Executing StatusCodeResult, setting HTTP status code {StatusCode}"
    ],
    "ExcludesApiEndpoint": [ "/health" ],
    "AllowedHosts": "*",
    "Kestrel": {
        "EndPoints": {
            "Http": {
                "Url": "http://*:5000"
            }
        }
    },
    "TokenExpireTime": 60,
    "ConfigService": [ "https://s1-config-service.starixnet.com/" ],
    "Sentry": {
        "Dsn": "https://48a9ac90790cc8267250b8f2fd4ad824@sentry-s1.nexentgame.com/14",
        "SendDefaultPii": true,
        "MaxRequestBodySize": "Always",
        "MinimumBreadcrumbLevel": "Debug",
        "MinimumEventLevel": "Warning",
        "AttachStackTrace": true,
        "Debug": true,
        "DiagnosticLevel": "Error",
        "TracesSampleRate": 1.0
    },
    "EmailSetting": {
        "FromMail": "no-reply-s1@starixsoft.com",
        "FromName": "no-reply-s1",
        "SmtpServer": "smtp.nexdev.net",
        "Port": 25,
        "Username": "",
        "Password": ""
    },
    "IsUsingMailSMTP": true,
    "BrandName": "Nova88 Solutions"
}
