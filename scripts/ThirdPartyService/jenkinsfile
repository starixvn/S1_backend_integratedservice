pipeline {
    agent none
    environment {
        env = 'Development'
        registry = '13.213.82.69:8082'
        proj = 'thirdpartyservice'
    }
    stages {
        stage('Build') {
            agent { node { label 'Build' } }
            steps {
                script {
                    env.version = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
                sh 'docker build -f ./ThirdPartyService/ThirdPartyService/Dockerfile -t ${registry}/${proj}:${version} .'
                sh 'docker login ${registry} -u admin -p 123456'
                sh 'docker push ${registry}/${proj}:${version}'
            }
        }
        stage('Deploy') {
            agent { node { label 'master' } }
            steps {
                sh 'hostname'
            }
        }
    }
}
