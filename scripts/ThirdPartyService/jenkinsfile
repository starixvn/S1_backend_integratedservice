pipeline {
    agent none
    environment {
        env = 'Development'
        registry = '13.213.82.69/integratedservice/thirdpartyservice'
        ansible_path = '/var/jenkins_home/ansible/backend'
    }
    stages {
        stage('Build') {
            agent { node { label 'Build' } }
            steps {
                script {
                    env.version = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
                sh 'sudo docker build -f ./ThirdPartyService/ThirdPartyService/Dockerfile -t ${registry}${version} .'
                sh 'sudo docker push ${registry}:${version}'
                sh 'sudo docker rmi ${registry}:${version}'
            }
        }
        stage('Deploy') {
            agent { node { label 'master' } }
            steps {
                sh 'ansible-playbook -i {ansible_path}/DEV.AWS.yml ${ansible_path}/deploy.yml --extra-vars "host=linux-dev-worker docker_name=dev_thirdpartyservice image=integratedservice/thirdpartyservice:${version} env=${env} docker_ports=55996:55996 volume=/logs/tpservice:/tpservice"'
            }
        }
    }
}
